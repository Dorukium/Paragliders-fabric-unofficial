{
  "schemaVersion": 1,
  "id": "paraglider",
  "version": "${version}",
  "name": "Paraglider (Unofficial Fabric 26.2 Port)",
  "description": "BotW-style paragliders and stamina. Unofficial Fabric port of Paraglider 26.2.1.",
  "authors": [
    "Tictim"
  ],
  "contributors": [
    "Fabric 26.2 port contributors"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/paragliders",
    "sources": "https://github.com/Tictim/Paraglider"
  },
  "license": "GPL-3.0-only",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "tictim.paraglider.ParagliderMod"
    ],
    "client": [
      "tictim.paraglider.ParagliderClientMod"
    ],
    "paraglider-plugin": [
      "tictim.paraglider.plugin.ParagliderDefaultPlugin"
    ]
  },
  "mixins": [
    "paraglider.mixins.json",
    {
      "config": "paraglider.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "paraglider.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0+26.2",
    "forgeconfigapiport": ">=26.2.1",
    "minecraft": "~26.2-",
    "java": ">=25"
  },
  "custom": {
    "paraglider:port": {
      "upstreamVersion": "26.2.1",
      "upstreamCommit": "21027aea65f13c45ca56e39ffd5a2dbc37148645",
      "portVersion": "26.2.1+fabric"
    }
  }
}
